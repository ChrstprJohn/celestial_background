  "narrative": {
    "northStar": "The Editorial Sky",
    "overview": "\n**Creative North Star: \"The Editorial Sky\"**\n\nCelestial pairs the quiet clarity of an editorial page with the scale and color of authentic astronomy photography. Warm cream space, forest controls, a large serif voice, and restrained sans-serif details make a personal date feel inviting and easy to explore.\n\nThe interface stays calm around the photograph. Generous spacing and thin rules organize the page; real NASA imagery supplies its richest color and depth. Motion introduces the copy and image once and respects reduced-motion preferences.",
    "keyCharacteristics": [
      "Warm cream ground and forest actions.",
      "Instrument Serif display type with DM Sans interface text.",
      "Authentic astronomy photography with visible source and credit.",
      "Flat surfaces, thin dividers, and gently curved controls.",
      "Responsive editorial columns that stack on mobile."
    ],
    "rules": [
      {
        "name": "The Photograph Color Rule",
        "body": "Let authentic astronomy imagery provide the vivid color; keep interface surfaces within the cream and green palette.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Instrument Serif for expressive headings and photograph statements; use DM Sans for controls, prose, dates, navigation, and credits.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Preserve the current flat surfaces and thin dividers when extending the interface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use cream surfaces, forest actions, and restrained green text around astronomy imagery.",
      "Do pair Instrument Serif headings with DM Sans controls and prose.",
      "Do preserve visible keyboard focus, labelled date entry, inline errors, and reduced-motion behavior.",
      "Do show authentic NASA imagery, source links, and available credits.",
      "Do stack the editorial columns and date controls at the implemented responsive widths."
    ],
    "donts": [
      "Don't replace authentic astronomy photography with a simulated star scene or fabricated result.",
      "Don't add shadows or rounded media cards to the existing flat editorial surfaces.",
      "Don't hide the archive limit, failed-media explanation, or source attribution.",
      "Don't require animation to reveal or access content.",
      "Don't repeat the returned NASA title in an additional result label."
    ]
  }
